# Start with an empty context. Only application sources and build inputs below
# may enter either the existing Dockerfiles or deploy/workspace/Dockerfile.
**
!LICENSE
!backend/
!backend/*.py
!backend/README.md
!backend/pyproject.toml
!backend/uv.lock
!backend/.python-version
!backend/app/
!backend/app/**
!backend/sql/
!backend/sql/**
!front/
!front/package.json
!front/pnpm-lock.yaml
!front/index.html
!front/*.svg
!front/tsconfig*.json
!front/vite.config.ts
!front/tailwind.config.js
!front/postcss.config.cjs
!front/src/
!front/src/**
!front/public/
!front/public/**
!deploy/
!deploy/**

